# Copy this file to ".env" and change the values. NEVER commit ".env".
NODE_ENV=development
PORT=5000

# PostgreSQL ("docker compose up -d" gives you exactly these values)
DB_HOST=localhost
DB_PORT=5432
DB_USER=gaari
DB_PASSWORD=gaari_dev_password
DB_DATABASE=gaari_bhara

# Login tokens. Use a long random value (at least 16 characters).
JWT_BEARER_SECRET=change-me-to-a-long-random-value-1234567890
# Token lifetime in seconds (86400 = 1 day)
JWT_TTL=86400

# Browser addresses allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# DEVELOPMENT ONLY: lets you call private routes with header  x-test-user-id: <user uuid>
# instead of a token (get the ids from "pnpm seed:demo"). Ignored in production.
ALLOW_TEST_USER_HEADER=true
# Set to true only for automated tests
THROTTLE_DISABLED=false

# Not needed for the midterm (live chat adapter later)
REDIS_HOST=localhost
REDIS_PORT=6379
